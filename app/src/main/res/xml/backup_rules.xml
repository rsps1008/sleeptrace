<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Sleep and device-use records are sensitive and remain on this device. -->
    <exclude domain="sharedpref" path="sleeptrace_records.xml" />
    <exclude domain="sharedpref" path="sleeptrace_motion.xml" />
    <exclude domain="database" path="motion.db" />
    <exclude domain="file" path="datastore/sleeptrace_settings.preferences_pb" />
</full-backup-content>
